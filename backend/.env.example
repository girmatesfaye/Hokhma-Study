# Server & Network Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/hokhma_study

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Cloudinary (Cover Image Uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail Service (Nodemailer for Contact Form)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVER_EMAIL=admin@hokhmastudy.org

# One-Time Admin Setup (Backend-only, never expose to frontend or git)
INITIAL_ADMIN_EMAIL=admin@hokhma.org
INITIAL_ADMIN_PASSWORD=AdminPassword123!
INITIAL_ADMIN_NAME=Admin
