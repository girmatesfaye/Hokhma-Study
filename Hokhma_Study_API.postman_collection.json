            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"The Problem of Evil: A Cumulative Defense\",\n  \"titleAm\": \"የክፋት ችግር፡ ክርስቲያናዊ መልስ\",\n  \"topicSlug\": \"philosophy\",\n  \"difficulty\": \"intermediate\",\n  \"readingTime\": 9,\n  \"publishDate\": \"2026-10-10\",\n  \"excerpt\": \"An intellectual and pastoral exploration of the classical problem of pain and suffering.\",\n  \"excerptAm\": \"ስለ ስቃይና መከራ የሚነሱ ጥያቄዎች ክርስቲያናዊ ምላሽ።\",\n  \"tags\": [\n    \"philosophy\",\n    \"theodicy\",\n    \"faith\"\n  ],\n  \"content\": [\n    {\n      \"type\": \"header\",\n      \"text\": \"Introduction\",\n      \"textAm\": \"መግቢያ\",\n      \"level\": 2\n    },\n    {\n      \"type\": \"paragraph\",\n      \"text\": \"The existence of suffering is one of the most pressing objections against classical theism.\",\n      \"textAm\": \"የስቃይ መኖር በእግዚአብሔር ህልውና ላይ ከሚነሱ ዋነኛ ጥያቄዎች አንዱ ነው።\"\n    }\n  ],\n  \"footnotes\": [],\n  \"featured\": false,\n  \"isPublished\": true,\n  \"commentsAllowed\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/articles",
              "host": [
                "{{baseUrl}}"
